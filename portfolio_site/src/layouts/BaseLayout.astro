---
import '../styles/global.css';
import '../styles/custom-sections.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  socialImage?: string;
  socialImageAlt?: string;
}

const { title, description, noindex = false, socialImage, socialImageAlt } = Astro.props;
const canonicalUrl = Astro.url.href;
// Each page shares its own preview; without this every link previews the same project.
// socialImage may already carry BASE_URL (resolveAssetUrl applies it), so the
// base is only added when it is missing.
const rawBase = import.meta.env.BASE_URL || '/';
const baseUrl = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const socialCandidate = socialImage?.trim() || `${baseUrl}project-assets/brox/showcase.jpg`;
const socialImagePath = /^https?:\/\//.test(socialCandidate)
  ? socialCandidate
  : socialCandidate.startsWith(baseUrl)
    ? socialCandidate
    : `${baseUrl}${socialCandidate.replace(/^\/+/, '')}`;
const socialImageUrl = new URL(socialImagePath, Astro.url.origin).href;
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Eslam Tarek Nabawy',
  url: new URL(import.meta.env.BASE_URL, Astro.url.origin).href,
  jobTitle: 'Software Engineer | DevOps, AIOps & Automation',
  sameAs: [
    'https://github.com/EslamNabawy',
    'https://www.linkedin.com/in/eslam-tarek-nabawy/',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0b0f" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    {socialImageAlt && <meta property="og:image:alt" content={socialImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    {socialImageAlt && <meta name="twitter:image:alt" content={socialImageAlt} />}
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body class="min-h-screen font-sans antialiased">
    <slot />
  </body>
</html>
