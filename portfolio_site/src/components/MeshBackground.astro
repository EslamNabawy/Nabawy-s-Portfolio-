---
/**
 * Drifting node-and-edge field behind the page, read as a service mesh graph.
 * Nodes near the pointer light up and their edges brighten with them.
 *
 * Replaces an earlier plain particle canvas: same drifting teal dots, but with
 * the edges and the pointer reaction that made it worth looking at.
 *
 * Decorative only, so the canvas is aria-hidden and never takes the pointer.
 */
---

<canvas class="v2-mesh" aria-hidden="true"></canvas>

<style>
  .v2-mesh {
    position: fixed;
    z-index: 0;
    inset: 0;
    pointer-events: none;
  }
</style>

<script>
  type Node = { x: number; y: number; vx: number; vy: number; r: number };

  const canvas = document.querySelector<HTMLCanvasElement>('canvas.v2-mesh');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    /** Distance between two nodes before an edge is drawn. */
    const LINK = 168;
    /** Radius around the pointer that lights nodes up. */
    const REACH = 200;
    const BASE = '122, 138, 170';
    const LIT = '0, 255, 200';

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(pointer: fine)');

    let nodes: Node[] = [];
    let w = 0;
    let h = 0;
    let raf = 0;
    const pointer = { x: 0, y: 0, active: false };

    function build() {
      w = window.innerWidth;
      h = window.innerHeight;

      // Capping at 2 keeps the fill rate sane on phones that report 3 or 4.
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      canvas!.style.width = `${w}px`;
      canvas!.style.height = `${h}px`;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      const count = Math.max(16, Math.min(92, Math.round((w * h) / 15000)));
      nodes = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.16,
        vy: (Math.random() - 0.5) * 0.16,
        r: 1.1 + Math.random() * 1.3,
      }));
    }

    /** How strongly the pointer lights this node, 0 to 1. */
    function lit(n: Node) {
      if (!pointer.active) return 0;
      const d = Math.hypot(n.x - pointer.x, n.y - pointer.y);
      return d > REACH ? 0 : 1 - d / REACH;
    }

    function draw() {
      ctx!.clearRect(0, 0, w, h);

      for (let i = 0; i < nodes.length; i += 1) {
        const a = nodes[i];
        const la = lit(a);

        for (let j = i + 1; j < nodes.length; j += 1) {
          const b = nodes[j];
          const d = Math.hypot(a.x - b.x, a.y - b.y);
          if (d > LINK) continue;

          const near = Math.min(la, lit(b));
          const alpha = (1 - d / LINK) * (0.13 + near * 0.55);
          ctx!.strokeStyle = `rgba(${near > 0.05 ? LIT : BASE}, ${alpha})`;
          ctx!.lineWidth = 1;
          ctx!.beginPath();
          ctx!.moveTo(a.x, a.y);
          ctx!.lineTo(b.x, b.y);
          ctx!.stroke();
        }

        ctx!.fillStyle = `rgba(${la > 0.05 ? LIT : BASE}, ${0.3 + la * 0.65})`;
        ctx!.beginPath();
        ctx!.arc(a.x, a.y, a.r + la * 1.8, 0, Math.PI * 2);
        ctx!.fill();
      }
    }

    function step() {
      for (const n of nodes) {
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < 0 || n.x > w) n.vx *= -1;
        if (n.y < 0 || n.y > h) n.vy *= -1;
      }
      draw();
      raf = requestAnimationFrame(step);
    }

    function start() {
      // Reduced motion keeps the picture but drops the drift and the pointer.
      if (raf || reduced.matches || document.hidden) return;
      raf = requestAnimationFrame(step);
    }

    function stop() {
      cancelAnimationFrame(raf);
      raf = 0;
    }

    function rebuild() {
      build();
      if (reduced.matches) draw();
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        rebuild();
        start();
      }, 180);
    });

    if (finePointer.matches) {
      // The canvas is fixed to the viewport, so client coordinates are already
      // its coordinates and scrolling needs no correction.
      window.addEventListener('pointermove', (event) => {
        if (reduced.matches) return;
        pointer.x = event.clientX;
        pointer.y = event.clientY;
        pointer.active = true;
      });

      document.addEventListener('pointerleave', () => {
        pointer.active = false;
      });
    }

    reduced.addEventListener('change', () => {
      stop();
      pointer.active = false;
      if (reduced.matches) draw();
      else start();
    });

    rebuild();
    start();
  }
</script>
