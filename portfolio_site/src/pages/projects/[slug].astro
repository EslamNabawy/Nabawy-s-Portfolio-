---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SmartImage from '../../components/SmartImage.astro';
import imageVariants from '../../lib/image-variants.json';
import { getPortfolioData, getProjectHeroImage } from '../../lib/portfolio-data';
import type { Project, SiteConfig } from '../../lib/types';
import '../../styles/project-detail.css';

import { projectDetails } from '../../lib/project-details';

export async function getStaticPaths() {
  const { config, projects } = await getPortfolioData();
  const preferredProjectOrder = [
    'sentinels',
    'fairmatch',
    'ai-workflow-automation',
    'brox',
    'rain-p2p-messenger',
    'devops-library',
    'campus-suit',
    'silvator',
    'so-she-picks-ecommerce',
  ];
  const orderedProjects = [...projects].sort((left, right) => {
    const leftIndex = preferredProjectOrder.indexOf(left.slug);
    const rightIndex = preferredProjectOrder.indexOf(right.slug);
    const normalizedLeft = leftIndex === -1 ? Number.MAX_SAFE_INTEGER : leftIndex;
    const normalizedRight = rightIndex === -1 ? Number.MAX_SAFE_INTEGER : rightIndex;
    if (normalizedLeft !== normalizedRight) {
      return normalizedLeft - normalizedRight;
    }
    return left.display_order - right.display_order;
  });

  return orderedProjects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      config,
      nextProject: orderedProjects[(index + 1) % orderedProjects.length],
      project,
    },
  }));
}

interface Props {
  config: SiteConfig;
  nextProject: Project;
  project: Project;
}

const { config, nextProject, project } = Astro.props as Props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const heroImage = getProjectHeroImage(project);
const allImages = project.project_images ?? [];
const heroAlt =
  allImages.find((image) => image.image_url === heroImage)?.alt_text ??
  `${project.title} project preview`;
const primaryScreen = allImages.find((image) => image.image_url !== heroImage) ?? allImages[0] ?? null;
const thumbImages = primaryScreen
  ? allImages.filter((image) => image.id !== primaryScreen.id && image.image_url !== heroImage)
  : allImages;
// The hero shot is not repeated in the gallery, so count what the gallery actually shows.
const galleryCount = thumbImages.length + (primaryScreen ? 1 : 0);

const fullSizeSrc = (url: string) => {
  const key = url.startsWith(base) ? url.slice(base.length) : url.replace(/^\/+/, '');
  const entry = (imageVariants as unknown as Record<string, { webp: [number, string][] }>)[key];
  const largest = entry?.webp.at(-1);
  return largest ? `${base}${largest[1]}` : url;
};
const summary = project.short_description ?? project.description;
const content = projectDetails[project.slug] ?? {
  category: 'Software Project',
  subtitle: summary,
  type: 'Software',
  platform: 'Cross-platform',
  timeline: 'Current build',
  status: project.is_published ? 'Published case study' : 'Draft',
  highlights: [
    { title: 'Product scope', description: summary },
    { title: 'Engineering role', description: project.role ?? 'Built as a software engineering project.' },
    { title: 'Impact', description: project.impact ?? 'Delivered a focused working product experience.' },
  ],
  decisions: [
    {
      title: 'Implementation focus',
      description: project.architecture_notes ?? project.description,
    },
  ],
  layers: [{ name: 'Stack', items: project.tech_stack }],
};

const displayDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  year: 'numeric',
});
const updatedLabel = project.updated_at ? displayDate.format(new Date(project.updated_at)) : 'Current';
const nextHref = `${base}projects/${nextProject.slug}/`;
const nextSummary = nextProject.short_description ?? nextProject.description;
const phoneHref = config.phone ? `tel:${config.phone.replace(/[^\d+]/g, '')}` : null;
const contactLinks = [
  { label: config.email, href: config.email ? `mailto:${config.email}` : null, text: 'Email' },
  { label: 'GitHub', href: config.github_url, text: 'GitHub' },
  { label: 'LinkedIn', href: config.linkedin_url, text: 'LinkedIn' },
  { label: config.phone, href: phoneHref, text: 'Phone' },
].filter((item) => item.href && item.label) as { label: string; href: string; text: string }[];

type CaseStudyBlock = { quote: boolean; html: string };

const escapeHtml = (value: string) =>
  value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');

const inlineHtml = (value: string) =>
  escapeHtml(value)
    .replace(/\*\*([\s\S]+?)\*\*/g, '<strong>$1</strong>')
    .replace(/`([^`]+)`/g, '<code>$1</code>');

const caseStudyBlocks: CaseStudyBlock[] = (project.case_study_markdown ?? '')
  .split(/\n\s*\n/)
  .map((chunk) => chunk.trim())
  .filter(Boolean)
  .map((chunk) => {
    const quote = chunk.startsWith('>');
    const text = chunk
      .split('\n')
      .map((line) => line.replace(/^\s*>\s?/, '').trim())
      .filter(Boolean)
      .join(' ');
    return { quote, html: inlineHtml(text) };
  });

// Describe the project itself, not just its author, so a case study can appear
// as a work rather than an anonymous page.
const absolute = (path: string) =>
  /^https?:\/\//.test(path) ? path : new URL(path, Astro.url.origin).href;
const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: project.title,
  headline: project.title,
  description: summary,
  url: Astro.url.href,
  ...(heroImage ? { image: absolute(heroImage) } : {}),
  ...(project.github_url ? { codeRepository: project.github_url } : {}),
  ...(project.updated_at ? { dateModified: project.updated_at } : {}),
  programmingLanguage: project.tech_stack,
  keywords: project.tech_stack.join(', '),
  creativeWorkStatus: content.status,
  author: {
    '@type': 'Person',
    name: config.name,
    url: new URL(import.meta.env.BASE_URL, Astro.url.origin).href,
  },
};
---

<BaseLayout
  title={`${project.title} | Project`}
  description={summary}
  socialImage={heroImage || undefined}
  socialImageAlt={heroImage ? heroAlt : undefined}
  schema={projectSchema}
>
  <main class="pd-project">
    <canvas id="pd-bg-canvas" aria-hidden="true"></canvas>
    <div class="pd-progress" id="pd-progress" aria-hidden="true"></div>

    <header class="pd-header">
      <nav class="pd-nav" aria-label="Project navigation">
        <a class="pd-nav-logo" href={base}>eslam<em>.dev</em></a>
        <a class="pd-nav-back" href={`${base}#projects`} aria-label="Back to all projects">
          <span aria-hidden="true">&larr;</span>
          All Projects
        </a>
        <a class="pd-nav-hire" href={`${base}#contact`}>Get In Touch</a>
      </nav>
    </header>

    <section class="pd-hero" id="project-hero">
      <div class:list={['pd-hero-media', `pd-tint-${project.slug}`]}>
        {heroImage && (
          <SmartImage src={heroImage} alt={heroAlt} sizes="100vw" loading="eager" fetchpriority="high" />
        )}
      </div>
      <div class="pd-hero-overlay"></div>

      <div class="pd-hero-content">
        <p class="pd-eyebrow pd-reveal"><span></span>{content.category}</p>
        <h1 class="pd-title pd-reveal">{project.title}</h1>
        <p class="pd-subtitle pd-reveal">{content.subtitle}</p>

        <div class="pd-meta-row pd-reveal">
          <span class="pd-tag">{content.platform}</span>
          <span class="pd-dot"></span>
          <span>{updatedLabel}</span>
          <span class="pd-dot"></span>
          <span>{project.featured ? 'Featured project' : 'Project case study'}</span>
        </div>

        <div class="pd-ctas pd-reveal">
          {project.github_url && (
            <a class="pd-btn pd-btn-fill" href={project.github_url} target="_blank" rel="noreferrer">
              Source
            </a>
          )}
          {project.live_url && (
            <a class="pd-btn pd-btn-fill" href={project.live_url} target="_blank" rel="noreferrer">
              Live Build
            </a>
          )}
          {project.slug === 'fairmatch' && (
            <a
              class="pd-btn pd-btn-fill"
              href={`${base}fairmatch-explainer.pdf`}
              target="_blank"
              rel="noreferrer"
            >
              Team Explainer (PDF)
            </a>
          )}
          {allImages.length > 0 && <a class="pd-btn pd-btn-line" href="#screens">Screenshots</a>}
          <a class="pd-btn pd-btn-line" href="#details">Details</a>
        </div>

        <div class="pd-facts pd-reveal" aria-label="Project quick facts">
          <div>
            <span>Role</span>
            <strong>{project.role ?? 'Software Engineer'}</strong>
          </div>
          <div>
            <span>Type</span>
            <strong>{content.type}</strong>
          </div>
          <div>
            <span>Media</span>
            <strong>{galleryCount} screenshots</strong>
          </div>
        </div>
      </div>
    </section>

    <div class="pd-body" id="details">
      <div class="pd-main-col">
        <section class="pd-section" id="overview">
          <p class="pd-section-tag pd-reveal">Overview</p>
          <h2 class="pd-section-title pd-reveal">What I built</h2>
          <p class="pd-overview pd-reveal">{project.description}</p>
          {project.impact && <p class="pd-overview pd-reveal">{project.impact}</p>}
          {caseStudyBlocks.map((block) =>
            block.quote ? (
              <blockquote class="pd-overview pd-quote pd-reveal" set:html={block.html} />
            ) : (
              <p class="pd-overview pd-reveal" set:html={block.html} />
            ),
          )}
        </section>

        {allImages.length > 0 && (
          <section class="pd-section pd-screens-section" id="screens">
            <p class="pd-section-tag pd-reveal">Screens</p>
            <h2 class="pd-section-title pd-reveal">Product screenshots</h2>

            {primaryScreen && (
              <button
                class="pd-screen-primary pd-reveal"
                type="button"
                data-full={fullSizeSrc(primaryScreen.image_url)}
                data-alt={primaryScreen.alt_text ?? `${project.title} primary screenshot`}
                aria-label={`Open ${primaryScreen.alt_text ?? `${project.title} primary screenshot`} in full screen`}
              >
                <SmartImage
                  src={primaryScreen.image_url}
                  alt={primaryScreen.alt_text ?? `${project.title} primary screenshot`}
                  sizes="(min-width: 960px) 62vw, 92vw"
                  loading="eager"
                />
                <span>{primaryScreen.alt_text ?? `${project.title} screen`}</span>
              </button>
            )}

            {thumbImages.length > 0 && (
              <div class="pd-screens-grid pd-reveal">
                {thumbImages.map((image, index) => (
                  <button
                    class="pd-screen-thumb"
                    type="button"
                    data-full={fullSizeSrc(image.image_url)}
                    data-alt={image.alt_text ?? `${project.title} screenshot ${index + 1}`}
                    aria-label={`Open ${image.alt_text ?? `${project.title} screenshot ${index + 1}`} in full screen`}
                  >
                    <SmartImage
                      src={image.image_url}
                      alt={image.alt_text ?? `${project.title} screenshot ${index + 1}`}
                      sizes="(min-width: 960px) 20vw, (min-width: 760px) 30vw, 92vw"
                      loading="lazy"
                    />
                    <span>{String(index + 1).padStart(2, '0')}</span>
                  </button>
                ))}
              </div>
            )}
          </section>
        )}

        <section class="pd-section" id="highlights">
          <p class="pd-section-tag pd-reveal">Highlights</p>
          <h2 class="pd-section-title pd-reveal">What makes it notable</h2>
          <div class="pd-highlight-list">
            {content.highlights.map((item) => (
              <article class="pd-highlight pd-reveal">
                <span aria-hidden="true"></span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="pd-section" id="engineering">
          <p class="pd-section-tag pd-reveal">Engineering</p>
          <h2 class="pd-section-title pd-reveal">Decisions and constraints</h2>
          <div class="pd-decision-list">
            {content.decisions.map((item, index) => (
              <article class="pd-decision pd-reveal">
                <small>Decision {String(index + 1).padStart(2, '0')}</small>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="pd-section" id="architecture">
          <p class="pd-section-tag pd-reveal">Architecture</p>
          <h2 class="pd-section-title pd-reveal">How it is structured</h2>

          <div class="pd-arch-viz pd-reveal" role="region" aria-label="Interactive architecture diagram">
            <div class="pd-arch-flow" role="list">
              {content.layers.map((layer, index) => (
                <button
                  class="pd-arch-node"
                  role="listitem"
                  type="button"
                  data-layer-index={index}
                  data-layer-name={layer.name}
                  data-layer-items={JSON.stringify(layer.items)}
                  aria-pressed="false"
                  aria-describedby={`arch-detail-${project.slug}`}
                >
                  <span class="pd-arch-node-index">{String(index + 1).padStart(2, '0')}</span>
                  <span class="pd-arch-node-name">{layer.name}</span>
                  <span class="pd-arch-node-count">{layer.items.length} components</span>
                  {index < content.layers.length - 1 && (
                    <span class="pd-arch-connector" aria-hidden="true"></span>
                  )}
                </button>
              ))}
            </div>

            <div
              class="pd-arch-detail"
              id={`arch-detail-${project.slug}`}
              aria-live="polite"
              aria-atomic="true"
            >
              <p class="pd-arch-detail-hint">Click a layer to inspect its components</p>
            </div>
          </div>

          {project.architecture_notes && (
            <p class="pd-architecture-note pd-reveal">{project.architecture_notes}</p>
          )}
        </section>
      </div>

      <aside class="pd-sidebar" aria-label="Project sidebar">
        <div class="pd-sidebar-card pd-reveal-r">
          <p class="pd-sidebar-label">Jump to</p>
          <div class="pd-side-nav">
            <a href="#overview" class="active">Overview</a>
            {allImages.length > 0 && <a href="#screens">Screenshots</a>}
            <a href="#highlights">Highlights</a>
            <a href="#engineering">Engineering</a>
            <a href="#architecture">Architecture</a>
          </div>
        </div>

        <div class="pd-sidebar-card pd-reveal-r">
          <p class="pd-sidebar-label">Project info</p>
          <dl class="pd-info-list">
            <div>
              <dt>Type</dt>
              <dd>{content.type}</dd>
            </div>
            <div>
              <dt>Platform</dt>
              <dd>{content.platform}</dd>
            </div>
            <div>
              <dt>Timeline</dt>
              <dd>{content.timeline}</dd>
            </div>
            <div>
              <dt>Role</dt>
              <dd>{project.role ?? 'Software Engineer'}</dd>
            </div>
            <div>
              <dt>Status</dt>
              <dd>{content.status}</dd>
            </div>
            <div>
              <dt>Updated</dt>
              <dd>{updatedLabel}</dd>
            </div>
          </dl>
        </div>

        <div class="pd-sidebar-card pd-reveal-r">
          <p class="pd-sidebar-label">Tech stack</p>
          <div class="pd-stack">
            {project.tech_stack.map((item) => (
              <button class:list={['pd-stack-tag', 'is-hot']} type="button" aria-pressed="true">{item}</button>
            ))}
          </div>
        </div>

        <div class="pd-sidebar-card pd-sidebar-cta pd-reveal-r">
          <p>Interested in similar work?</p>
          {config.email && <a class="pd-btn pd-btn-fill" href={`${base}#contact`}>Get In Touch</a>}
          <a class="pd-btn pd-btn-line" href={base}>Back to Portfolio</a>
        </div>
      </aside>
    </div>

    <section class="pd-next-project" id="next-project">
      <div>
        <p>Next project</p>
        <h2>{nextProject.title}</h2>
        <span>{nextSummary}</span>
      </div>
      <a href={nextHref} aria-label={`Open ${nextProject.title}`}>&rarr;</a>
    </section>

    <section class="pd-contact" id="contact-section">
      <div class="pd-contact-glow"></div>
      <div class="pd-contact-inner">
        <h2 class="pd-reveal">Let's build <em>something useful</em></h2>
        <p class="pd-reveal">Open to software engineering roles, freelance builds, and practical product collaborations.</p>
        <div class="pd-contact-links pd-reveal">
          {contactLinks.map((item) => (
            <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noreferrer' : undefined}>
              <span>{item.text}</span>
              {item.label}
            </a>
          ))}
        </div>
      </div>
    </section>

    <footer class="pd-footer">
      <p>&copy; 2026 <em>Eslam Tarek Nabawy</em></p>
      <p>Software Engineer &middot; Egypt &middot; <em>Built with intent</em></p>
    </footer>

    <div class="pd-lightbox" id="pd-lightbox" role="dialog" aria-modal="true" aria-labelledby="pd-lightbox-title" aria-hidden="true" tabindex="-1" hidden>
      <p class="pd-lightbox-counter" aria-live="polite"></p>
      <button class="pd-lightbox-close" type="button" aria-label="Close screenshot">Close</button>
      <button class="pd-lightbox-nav pd-lightbox-prev" type="button" aria-label="Previous screenshot" hidden>&larr;</button>
      {/* Hidden until opened, and lazy so the browser does not fetch it on load;
          the script swaps in the chosen screenshot. */}
      {heroImage && <img src={fullSizeSrc(heroImage)} alt={heroAlt} loading="lazy" decoding="async" />}
      <button class="pd-lightbox-nav pd-lightbox-next" type="button" aria-label="Next screenshot" hidden>&rarr;</button>
      <p class="pd-lightbox-caption" id="pd-lightbox-title"></p>
    </div>
  </main>
</BaseLayout>

<script>
  const progress = document.getElementById('pd-progress');
  const updateProgress = () => {
    if (!progress) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    progress.style.width = `${max > 0 ? (window.scrollY / max) * 100 : 0}%`;
  };
  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  const canvas = document.getElementById('pd-bg-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const context = canvas.getContext('2d');
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(window.innerWidth * dpr);
      canvas.height = Math.floor(window.innerHeight * dpr);
      canvas.style.width = `${window.innerWidth}px`;
      canvas.style.height = `${window.innerHeight}px`;
      context?.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    const particles = Array.from({ length: window.innerWidth < 760 ? 28 : 64 }, () => ({
      x: Math.random() * window.innerWidth,
      y: Math.random() * window.innerHeight,
      vx: (Math.random() - 0.5) * 0.22,
      vy: (Math.random() - 0.5) * 0.22,
      r: Math.random() * 1.3 + 0.5,
    }));
    let frameId: number | undefined;
    const draw = () => {
      if (!context || motionQuery.matches || document.hidden) return;
      context.clearRect(0, 0, window.innerWidth, window.innerHeight);
      particles.forEach((particle) => {
        particle.x += particle.vx;
        particle.y += particle.vy;
        if (particle.x < 0) particle.x = window.innerWidth;
        if (particle.x > window.innerWidth) particle.x = 0;
        if (particle.y < 0) particle.y = window.innerHeight;
        if (particle.y > window.innerHeight) particle.y = 0;
        context.beginPath();
        context.arc(particle.x, particle.y, particle.r, 0, Math.PI * 2);
        context.fillStyle = 'rgba(0,255,200,.58)';
        context.fill();
      });
      frameId = requestAnimationFrame(draw);
    };
    const stop = () => {
      if (frameId !== undefined) cancelAnimationFrame(frameId);
      frameId = undefined;
    };
    const start = () => {
      if (frameId === undefined && !motionQuery.matches && !document.hidden) draw();
    };
    resize();
    window.addEventListener('resize', resize);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    motionQuery.addEventListener('change', () => {
      stop();
      start();
    });
    start();
  }

  const revealElements = document.querySelectorAll('.pd-reveal,.pd-reveal-r');
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry, index) => {
        if (!entry.isIntersecting) return;
        window.setTimeout(() => entry.target.classList.add('is-on'), index * 45);
        revealObserver.unobserve(entry.target);
      });
    },
    { threshold: 0.1 },
  );
  revealElements.forEach((element) => revealObserver.observe(element));

  const sideLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.pd-side-nav a'));
  const observedSections = sideLinks
    .map((link) => document.querySelector(link.getAttribute('href') ?? ''))
    .filter((section): section is Element => section instanceof Element);
  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        sideLinks.forEach((link) => link.classList.remove('active'));
        document.querySelector(`.pd-side-nav a[href="#${entry.target.id}"]`)?.classList.add('active');
      });
    },
    { rootMargin: '-22% 0px -60% 0px', threshold: 0.01 },
  );
  observedSections.forEach((section) => sectionObserver.observe(section));

  document.querySelectorAll<HTMLButtonElement>('.pd-stack-tag').forEach((tag) => {
    tag.addEventListener('click', () => {
      const highlighted = tag.classList.toggle('is-hot');
      tag.setAttribute('aria-pressed', String(highlighted));
    });
  });

  // ── Architecture visualizer ──────────────────────────────────────────────
  (function initArchViz() {
    const viz = document.querySelector('.pd-arch-viz');
    if (!viz) return;
    const nodes = Array.from(viz.querySelectorAll<HTMLButtonElement>('.pd-arch-node'));
    const detail = viz.querySelector<HTMLElement>('.pd-arch-detail');
    if (!detail) return;

    let activeIndex: number | null = null;

    function renderDetail(node: HTMLButtonElement) {
      const name = node.dataset.layerName ?? '';
      let items: string[] = [];
      try { items = JSON.parse(node.dataset.layerItems ?? '[]'); } catch { /* ignore */ }
      detail!.innerHTML = `
        <div class="pd-arch-detail-inner">
          <span class="pd-arch-detail-label">${name}</span>
          <div class="pd-arch-detail-chips">
            ${items.map((item) => `<span class="pd-arch-chip">${item}</span>`).join('')}
          </div>
        </div>`;
    }

    function clearDetail() {
      detail!.innerHTML = '<p class="pd-arch-detail-hint">Click a layer to inspect its components</p>';
    }

    nodes.forEach((node, index) => {
      node.addEventListener('click', () => {
        if (activeIndex === index) {
          // Toggle off
          node.classList.remove('is-active');
          node.setAttribute('aria-pressed', 'false');
          activeIndex = null;
          clearDetail();
          return;
        }
        // Deactivate previous
        if (activeIndex !== null) {
          nodes[activeIndex]?.classList.remove('is-active');
          nodes[activeIndex]?.setAttribute('aria-pressed', 'false');
        }
        node.classList.add('is-active');
        node.setAttribute('aria-pressed', 'true');
        activeIndex = index;
        renderDetail(node);
      });
    });

    // Activate first node by default on load for discoverability
    if (nodes.length > 0) {
      nodes[0].classList.add('is-active');
      nodes[0].setAttribute('aria-pressed', 'true');
      activeIndex = 0;
      renderDetail(nodes[0]);
    }
  })();


  const lightbox = document.getElementById('pd-lightbox') as HTMLDivElement | null;
  const lightboxImage = lightbox?.querySelector('img');
  const closeButton = lightbox?.querySelector<HTMLButtonElement>('.pd-lightbox-close');
  const prevButton = lightbox?.querySelector<HTMLButtonElement>('.pd-lightbox-prev');
  const nextButton = lightbox?.querySelector<HTMLButtonElement>('.pd-lightbox-next');
  const lightboxCaption = lightbox?.querySelector<HTMLParagraphElement>('.pd-lightbox-caption');
  const lightboxCounter = lightbox?.querySelector<HTMLParagraphElement>('.pd-lightbox-counter');
  const screenButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-full]'));
  let lightboxIndex = -1;
  let lightboxTrigger: HTMLButtonElement | null = null;

  // Step through every screenshot without leaving the lightbox; wraps at both ends.
  const showScreen = (index: number) => {
    const total = screenButtons.length;
    if (!lightbox || !lightboxImage || total === 0) return;
    const wrapped = ((index % total) + total) % total;
    const button = screenButtons[wrapped];
    if (!button) return;
    const label = button.dataset.alt ?? 'Project screenshot';
    lightboxIndex = wrapped;
    lightboxTrigger = button;
    lightboxImage.src = button.dataset.full ?? '';
    lightboxImage.alt = label;
    if (lightboxCaption) lightboxCaption.textContent = label;
    if (lightboxCounter) {
      lightboxCounter.textContent = `${String(wrapped + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
    }
    if (prevButton) prevButton.hidden = total < 2;
    if (nextButton) nextButton.hidden = total < 2;
    // Warm the neighbours so stepping through the gallery does not flash an empty frame.
    [wrapped - 1, wrapped + 1].forEach((neighbour) => {
      const url = screenButtons[((neighbour % total) + total) % total]?.dataset.full;
      if (url) new Image().src = url;
    });
  };

  const closeLightbox = () => {
    if (!lightbox || !lightboxImage) return;
    lightbox.hidden = true;
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('pd-lightbox-open');
    lightboxTrigger?.focus();
    lightboxTrigger = null;
    lightboxIndex = -1;
    if (lightboxCaption) lightboxCaption.textContent = '';
    if (lightboxCounter) lightboxCounter.textContent = '';
  };

  screenButtons.forEach((button, index) => {
    button.addEventListener('click', () => {
      if (!lightbox || !lightboxImage) return;
      showScreen(index);
      lightbox.hidden = false;
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.classList.add('pd-lightbox-open');
      window.requestAnimationFrame(() => closeButton?.focus());
    });
  });

  prevButton?.addEventListener('click', () => showScreen(lightboxIndex - 1));
  nextButton?.addEventListener('click', () => showScreen(lightboxIndex + 1));
  closeButton?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) closeLightbox();
  });
  window.addEventListener('keydown', (event) => {
    if (!lightbox || lightbox.hidden) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      closeLightbox();
      return;
    }
    if (event.key === 'ArrowLeft') {
      event.preventDefault();
      showScreen(lightboxIndex - 1);
      return;
    }
    if (event.key === 'ArrowRight') {
      event.preventDefault();
      showScreen(lightboxIndex + 1);
      return;
    }
    if (event.key === 'Tab') {
      const focusable = [prevButton, nextButton, closeButton].filter(
        (element): element is HTMLButtonElement => element instanceof HTMLButtonElement && !element.hidden,
      );
      if (focusable.length === 0) return;
      const currentIndex = focusable.indexOf(document.activeElement as HTMLButtonElement);
      const nextIndex = event.shiftKey
        ? (currentIndex <= 0 ? focusable.length - 1 : currentIndex - 1)
        : (currentIndex + 1) % focusable.length;
      event.preventDefault();
      focusable[nextIndex]?.focus();
    }
  });
</script>
