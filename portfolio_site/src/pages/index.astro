---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPortfolioData, getProjectHeroImage } from '../lib/portfolio-data';
import type { Project } from '../lib/types';
import '../styles/portfolio-v2.css';

const { config, projects, skills } = await getPortfolioData();
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const resumeHref = config.resume_url ?? `${base}Eslam's%20Resume.pdf`;

const phoneHref = config.phone ? `tel:${config.phone.replace(/[^\d+]/g, '')}` : null;
const contactActions = [
  { label: 'Email', href: config.email ? `mailto:${config.email}` : null, icon: 'mail' },
  {
    label: 'Resume',
    href: resumeHref,
    icon: 'file',
    download: /^https?:\/\//i.test(resumeHref) ? undefined : 'Eslam Tarek Nabawy Resume.pdf',
    target: /^https?:\/\//i.test(resumeHref) ? '_blank' : undefined,
    rel: /^https?:\/\//i.test(resumeHref) ? 'noopener noreferrer' : undefined,
  },
  { label: 'Phone', href: phoneHref, icon: 'phone' },
  { label: 'GitHub', href: config.github_url, icon: 'github' },
  { label: 'LinkedIn', href: config.linkedin_url, icon: 'linkedin' },
].filter((item) => item.href) as {
  label: string;
  href: string;
  icon: string;
  download?: string;
  target?: string;
  rel?: string;
}[];

const preferredProjectOrder = [
  'brox',
  'ai-workflow-automation',
  'rain-p2p-messenger',
  'campus-suit',
  'silvator',
  'so-she-picks-ecommerce',
];

const orderedProjects = [...projects].sort((left, right) => {
  const leftIndex = preferredProjectOrder.indexOf(left.slug);
  const rightIndex = preferredProjectOrder.indexOf(right.slug);
  const normalizedLeft = leftIndex === -1 ? Number.MAX_SAFE_INTEGER : leftIndex;
  const normalizedRight = rightIndex === -1 ? Number.MAX_SAFE_INTEGER : rightIndex;
  if (normalizedLeft !== normalizedRight) {
    return normalizedLeft - normalizedRight;
  }
  return left.display_order - right.display_order;
});

const skillGroups =
  skills.length > 0
    ? skills
    : [
        {
          category: 'Product Engineering',
          items: ['Flutter', 'Dart', 'Responsive UI', 'State Management'],
        },
        {
          category: 'Data And Integrations',
          items: ['REST APIs', 'Realtime Data', 'Local Storage', 'Auth Flows'],
        },
        {
          category: 'Automation',
          items: ['n8n', 'LLM APIs', 'Webhooks', 'Workflow Design'],
        },
      ];

const highlightedSkills = new Set([
  'Flutter',
  'Dart',
  'BLoC',
  'Cubit',
  'Riverpod',
  'n8n Workflow Automation',
  'OpenAI API Integration',
  'Claude API Integration',
  'REST API Integration',
  'Git / GitHub',
]);

const skillId = (category: string) => `skill-${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;

const projectTone = (project: Project) =>
  ({
    brox: 'brox',
    'rain-p2p-messenger': 'rain',
    'campus-suit': 'campus',
    silvator: 'silvator',
    'ai-workflow-automation': 'ai',
    'so-she-picks-ecommerce': 'shop',
  })[project.slug] ?? 'default';

const projectMeta = (project: Project) =>
  ({
    brox: 'Desktop Operations',
    'rain-p2p-messenger': 'Android / Windows',
    'campus-suit': 'Campus Product',
    silvator: 'Mood Companion',
    'ai-workflow-automation': 'Omnichannel AI Support',
    'so-she-picks-ecommerce': 'Mobile Commerce',
  })[project.slug] ?? 'Software Product';

const projectHighlights: Record<string, string[]> = {
  brox: [
    'Offline-first operations console for desks, rooms, inventory, finance, staff, and memberships.',
    'Role-gated workflows, audit logs, backup / restore, local diagnostics, and release packaging.',
    'Built for repeated front-desk use rather than a one-screen demo.',
  ],
  'rain-p2p-messenger': [
    'Private peer chat across Android and Windows with explicit friend, call, and file states.',
    'Separates UI, persistence, realtime signaling, and WebRTC data / media transport.',
  ],
  'campus-suit': [
    'Graduation project covering onboarding, courses, grades, profile flows, and live campus data.',
    'Structured mobile screens built around clear student workflows.',
  ],
  silvator: [
    'Mood-aware quote, journal, saved insight, and heatmap flows across mobile and desktop screens.',
    'Local-first product surface focused on calm capture and reflection.',
  ],
  'ai-workflow-automation': [
    'Automated customer-service response delivery across WhatsApp and Telegram.',
    'Supabase memory, multi-provider AI routing, and safety gates keep conversations contextual and controlled.',
  ],
  'so-she-picks-ecommerce': [
    'Mobile ordering flow with backend order handling and loyalty points.',
    'Designed around straightforward browsing, checkout, and repeat-customer behavior.',
  ],
};

const projectImageDimensions: Record<string, { width: number; height: number }> = {
  brox: { width: 1600, height: 1000 },
  'rain-p2p-messenger': { width: 1800, height: 1125 },
  'campus-suit': { width: 1600, height: 1000 },
  silvator: { width: 1800, height: 1125 },
};

const skillCode = (category: string) => {
  const normalized = category.toLowerCase();
  if (normalized.includes('mobile')) return 'UI';
  if (normalized.includes('backend')) return 'DB';
  if (normalized.includes('automation') || normalized.includes('ai')) return 'AI';
  if (normalized.includes('engineering')) return 'CS';
  return category.slice(0, 2).toUpperCase();
};

const displayDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  year: 'numeric',
});

const projectCategory = (slug: string) => {
  if (['brox', 'rain-p2p-messenger', 'silvator'].includes(slug)) return 'cross-platform';
  if (['ai-workflow-automation'].includes(slug)) return 'ai-automation';
  return 'systems-web';
};

const timelineRoles = [
  {
    id: 'freelance-software-developer',
    category: 'engineering',
    categoryLabel: 'Engineering & Delivery',
    title: 'Freelance Software Developer',
    organization: 'Self-Employed / Client Work',
    period: 'Nov 2022 — Present',
    location: 'Remote · 6th October City, Egypt',
    statusLabel: 'Active',
    summary: 'Designing, engineering, and shipping production-grade cross-platform Flutter applications, local storage engines, and automated AI backend workflows for client products.',
    highlights: [
      'Built and shipped 6+ desktop & mobile applications (Brox, Rain P2P, Silvator, So She Picks).',
      'Engineered offline-first architecture using Hive and Drift SQLite engines with role-gated admin workflows.',
      'Constructed automated AI backend pipelines with n8n, Supabase conversation memory, and safety gates.',
      'Managed end-to-end client release cycles, version packaging, and GitHub Actions CI/CD deployment workflows.'
    ],
    techStack: ['Flutter', 'Dart', 'BLoC', 'Riverpod', 'Hive', 'Drift', 'n8n', 'Supabase', 'GitHub Actions'],
    metricsBadge: '⚡ 6+ Production Products Shipped'
  },
  {
    id: 'programming-instructor',
    category: 'teaching',
    categoryLabel: 'Teaching & Mentoring',
    title: 'Programming Instructor',
    organization: 'Private Coaching & Academic Mentoring',
    period: 'Feb 2022 — Present',
    location: '6th October City, Egypt',
    statusLabel: 'Active Mentor',
    summary: 'Designing structured computer science curricula for university and school students covering fundamentals, object-oriented design, data structures, algorithms, and mobile development.',
    highlights: [
      'Authored hands-on training modules in C++, Python, Dart, and object-oriented architecture patterns.',
      'Conducted weekly live code reviews, debugging workshops, and algorithm problem-solving sessions.',
      'Guided student capstone projects from software requirement specs to working mobile prototypes.'
    ],
    techStack: ['C++', 'Python', 'Dart', 'OOP', 'Data Structures', 'Algorithms', 'Software Design'],
    metricsBadge: '🎓 50+ Students Mentored'
  },
  {
    id: 'gdsc-flutter-head',
    category: 'community',
    categoryLabel: 'Tech Leadership',
    title: 'Flutter Head — Google Developer Student Club',
    organization: 'GDSC (Google Developer Student Club)',
    period: 'Oct 2022 — Oct 2023',
    location: 'Akhbar El-Yom Academy',
    statusLabel: 'Completed Term',
    summary: 'Led the Flutter engineering track, organizing technical workshops, mentoring student developers, and co-hosting regional Google tech community events.',
    highlights: [
      'Organized and delivered a 6-week Flutter bootcamp covering UI primitives, state management, and API consumption.',
      'Co-organized regional tech community events including Google I/O Extended and NextGen developer meetups.',
      'Established student peer-review groups that built 4 open-source community app projects.'
    ],
    techStack: ['Flutter', 'Dart', 'Technical Mentoring', 'Public Speaking', 'Community Leadership'],
    metricsBadge: '🚀 80+ Campus Developers Trained'
  },
  {
    id: 'icpc-core-team',
    category: 'community',
    categoryLabel: 'Competitive Programming',
    title: 'ICPC Core Team Member',
    organization: 'International Collegiate Programming Contest',
    period: 'Jun 2020 — Oct 2023',
    location: 'Akhbar El-Yom Academy',
    statusLabel: 'Completed Term',
    summary: 'Competed in algorithmic problem-solving contests while training university peers in graph theory, dynamic programming, and data structures.',
    highlights: [
      'Solved 300+ algorithmic problems across Codeforces, LeetCode, and competitive platforms.',
      'Organized mock problem-solving contests and taught graph traversal, greedy algorithms, and data structure optimizations.',
      'Helped prepare student teams for the Egyptian Collegiate Programming Contest (ECPC) qualifications.'
    ],
    techStack: ['C++', 'Algorithms', 'Graph Theory', 'Dynamic Programming', 'Competitive Math'],
    metricsBadge: '🏆 300+ Algorithmic Problems Solved'
  }
];

const icon = (name: string) => name;
---

<BaseLayout title={`${config.name} | Portfolio`} description={config.headline}>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <main id="main-content" class="v2-portfolio" tabindex="-1">
    <canvas id="v2-bg-canvas" aria-hidden="true"></canvas>
    <div class="v2-progress" id="v2-progress" aria-hidden="true"></div>

    <header class="v2-header">
      <nav class="v2-nav" aria-label="Primary navigation">
        <a class="v2-nav-logo" href={base}>eslam<em>.dev</em></a>
        <button
          class="v2-nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="primary-links"
          aria-label="Open navigation"
        >
          <span aria-hidden="true">Menu</span>
          <span class="sr-only">Toggle navigation</span>
        </button>
        <div class="v2-nav-links" id="primary-links">
          <a href="#projects">Projects</a>
          <a href="#skills">Skills</a>
          <a href="#experience">Experience</a>
          <a href="#contact">Contact</a>
        </div>
        {config.email && (
          <a class="v2-nav-hire" href="#contact">Hire Me</a>
        )}
      </nav>
    </header>

    <section class="v2-hero" id="hero">
      <div class="v2-hero-inner">
        <div class="v2-hero-copy v2-reveal-l">
          <p class="v2-eyebrow"><span></span> Flutter & Cross-Platform Engineer</p>
          <h1 class="v2-hero-title">
            Eslam Tarek
            <span>Nabawy</span>
          </h1>
          <p class="v2-hero-description">
            I design and ship production-grade software: cross-platform Flutter apps, AI-integrated systems,
            and reliable integrations — from architecture to deployment.
          </p>
          <div class="v2-hero-actions" aria-label="Primary actions">
            <a
              class="v2-btn v2-btn-fill"
              href={resumeHref}
              download={/^https?:\/\//i.test(resumeHref) ? undefined : 'Eslam Tarek Nabawy Resume.pdf'}
              target={/^https?:\/\//i.test(resumeHref) ? '_blank' : undefined}
              rel={/^https?:\/\//i.test(resumeHref) ? 'noopener noreferrer' : undefined}
            >
              Resume
            </a>
            {config.email && (
              <a class="v2-btn v2-btn-line" href={`mailto:${config.email}`}>Hire Me</a>
            )}
          </div>
        </div>

        <div class="v2-code-widget v2-reveal-r" aria-label="Profile summary card">
          <div class="v2-code-bar">
            <span></span>
            <span></span>
            <span></span>
            <small>profile.ts</small>
          </div>
          <pre><code><span class="v2-kw">const</span> engineer = {'{'}
  name: <span class="v2-str">'Eslam Nabawy'</span>,
  stack: [<span class="v2-str">'Flutter'</span>, <span class="v2-str">'Dart'</span>, <span class="v2-str">'Supabase'</span>, <span class="v2-str">'LangGraph'</span>],
  ships: <span class="v2-str">'mobile · desktop · AI systems'</span>,
  location: <span class="v2-str">'6th October City, Egypt'</span>,
  status: <span class="v2-str">'open to opportunities'</span>
{'}'};</code></pre>
        </div>
      </div>
    </section>

    <div class="v2-marquee" aria-hidden="true">
      <div class="v2-marquee-track">
        {['Flutter', 'Dart', 'BLoC', 'Riverpod', 'WebRTC', 'n8n', 'REST APIs', 'Local-first', 'AI-assisted delivery', 'GitHub Actions', 'Product UI', 'Automation'].map((item) => (
          <span><b>/</b>{item}</span>
        ))}
        {['Flutter', 'Dart', 'BLoC', 'Riverpod', 'WebRTC', 'n8n', 'REST APIs', 'Local-first', 'AI-assisted delivery', 'GitHub Actions', 'Product UI', 'Automation'].map((item) => (
          <span><b>/</b>{item}</span>
        ))}
      </div>
    </div>

    <section class="v2-section v2-skills" id="skills">
      <div class="v2-section-head">
        <p class="v2-section-tag">Skills</p>
        <h2>Capabilities, grouped for delivery</h2>
        <span>CV-backed technologies organized by the way they support product delivery: application platforms, integrations, data, AI workflows, and engineering practice.</span>
      </div>

      <div class="v2-skills-layout">
        <div class="v2-orbit" aria-hidden="true">
          <div></div>
          <div></div>
          <div></div>
          <i style="left:50%;top:0"></i>
          <i style="left:93%;top:70%"></i>
          <i style="left:12%;top:78%"></i>
          <strong>{skillGroups.reduce((total, group) => total + group.items.length, 0)}<small>skills</small></strong>
        </div>

        <div class="v2-skill-groups">
          {skillGroups.map((group) => (
            <article class="v2-skill-group" aria-labelledby={skillId(group.category)}>
              <div class="v2-skill-top">
                <span>{skillCode(group.category)}</span>
                <div>
                  <h3 id={skillId(group.category)}>{group.category}</h3>
                  <small>Capability group</small>
                </div>
              </div>
              <div class="v2-skill-tags">
                {group.items.map((item) => (
                  <button
                    type="button"
                    class:list={['v2-skill-tag', highlightedSkills.has(item) && 'v2-skill-tag-hot']}
                    data-skill={item.toLowerCase()}
                    aria-pressed="false"
                    title={`Click to highlight projects built with ${item}`}
                  >
                    {item}
                  </button>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="v2-section" id="projects">
      <div class="v2-section-head">
        <p class="v2-section-tag">Projects</p>
        <h2>Production-grade software, shown clearly</h2>
        <span>Featured work leads with four projects from my current engineering focus. Additional work remains available below for broader context.</span>
      </div>

      <div class="v2-filter-bar" role="tablist" aria-label="Filter projects by domain">
        <button type="button" class="v2-filter-pill" role="tab" aria-selected="true" data-filter="all">
          <span>All Work</span>
          <span class="v2-filter-pill-count">{orderedProjects.length}</span>
        </button>
        <button type="button" class="v2-filter-pill" role="tab" aria-selected="false" data-filter="cross-platform">
          <span>Cross-Platform</span>
          <span class="v2-filter-pill-count">{orderedProjects.filter(p => ['brox', 'rain-p2p-messenger', 'silvator'].includes(p.slug)).length}</span>
        </button>
        <button type="button" class="v2-filter-pill" role="tab" aria-selected="false" data-filter="ai-automation">
          <span>AI & Automation</span>
          <span class="v2-filter-pill-count">{orderedProjects.filter(p => ['ai-workflow-automation'].includes(p.slug)).length}</span>
        </button>
        <button type="button" class="v2-filter-pill" role="tab" aria-selected="false" data-filter="systems-web">
          <span>Systems & Web</span>
          <span class="v2-filter-pill-count">{orderedProjects.filter(p => ['campus-suit', 'so-she-picks-ecommerce'].includes(p.slug)).length}</span>
        </button>
      </div>

      <div class="v2-project-grid">
        {orderedProjects.map((project, index) => {
          const image = getProjectHeroImage(project);
          const href = `${base}projects/${project.slug}/`;
          const isPrimary = ['brox', 'ai-workflow-automation', 'rain-p2p-messenger', 'campus-suit'].includes(project.slug);
          const isLarge = project.slug === 'brox';
          const isWide = project.slug === 'so-she-picks-ecommerce';
          const imageDimensions = projectImageDimensions[project.slug];
          const highlights = projectHighlights[project.slug] ?? [project.impact ?? project.role ?? 'Built as a focused product experience.'];

          const additionalWorkHeading = !isPrimary && index === 4 ? (
            <div class="v2-project-divider" aria-label="Additional work" data-divider="true">
              <span>Additional work</span>
              <small>More experiments and product interfaces</small>
            </div>
          ) : null;

          return (
            <Fragment>
              {additionalWorkHeading}
              <article
                class:list={['v2-project-card', isPrimary && 'v2-project-card-primary', isLarge && 'v2-project-card-large', isWide && 'v2-project-card-wide']}
                data-category={projectCategory(project.slug)}
                data-tech-stack={JSON.stringify(project.tech_stack.map(s => s.toLowerCase()))}
              >
              <a href={href} aria-label={`View ${project.title} case study`}>
                <div class:list={['v2-project-media', `v2-tone-${projectTone(project)}`]}>
                  {image ? (
                    <img
                      src={image}
                      alt={`${project.title} screenshot mockup`}
                      width={imageDimensions?.width}
                      height={imageDimensions?.height}
                      loading={index === 0 ? 'eager' : 'lazy'}
                      fetchpriority={index === 0 ? 'high' : 'auto'}
                      decoding="async"
                    />
                  ) : (
                    <div class="v2-project-empty">Preview pending</div>
                  )}
                </div>
                <div class="v2-project-body">
                  <div class="v2-project-meta">
                    <span>{projectMeta(project)}</span>
                    <small>{project.updated_at ? displayDate.format(new Date(project.updated_at)) : 'Current'}</small>
                    {isPrimary ? <small class="v2-project-label v2-project-label-selected">Selected work</small> : <small class="v2-project-label">Additional work</small>}
                    <small class="v2-project-match-badge" hidden></small>
                  </div>
                  <h3>{project.title}</h3>
                  <p class="v2-project-role">{project.role ?? 'Software Engineer'}</p>
                  <p class="v2-project-description">{project.short_description ?? project.description}</p>
                  <div class="v2-project-highlights">
                    {highlights.slice(0, isLarge ? 3 : 2).map((highlight) => (
                      <span>{highlight}</span>
                    ))}
                  </div>
                  <div class="v2-project-stack">
                    {project.tech_stack.slice(0, 7).map((item) => (
                      <button
                        type="button"
                        class="v2-tech-tag"
                        data-tech={item.toLowerCase()}
                        title={`Find ${item} in Capabilities`}
                      >
                        {item}
                      </button>
                    ))}
                  </div>
                </div>
              </a>
              </article>
            </Fragment>
          );
        })}
      </div>
    </section>

    <section class="v2-section v2-experience" id="experience">
      <div class="v2-section-head">
        <p class="v2-section-tag">Experience & Leadership</p>
        <h2>Where the work happened</h2>
        <span>Teaching, freelance delivery, mentoring, and community leadership that back the engineering.</span>
      </div>

      <div class="v2-timeline-filters" role="tablist" aria-label="Filter experience by domain">
        <button type="button" class="v2-exp-pill" role="tab" aria-selected="true" data-exp-filter="all">
          <span>All Roles</span>
          <span class="v2-exp-pill-count">{timelineRoles.length}</span>
        </button>
        <button type="button" class="v2-exp-pill" role="tab" aria-selected="false" data-exp-filter="engineering">
          <span>Engineering</span>
          <span class="v2-exp-pill-count">{timelineRoles.filter(r => r.category === 'engineering').length}</span>
        </button>
        <button type="button" class="v2-exp-pill" role="tab" aria-selected="false" data-exp-filter="teaching">
          <span>Teaching</span>
          <span class="v2-exp-pill-count">{timelineRoles.filter(r => r.category === 'teaching').length}</span>
        </button>
        <button type="button" class="v2-exp-pill" role="tab" aria-selected="false" data-exp-filter="community">
          <span>Leadership</span>
          <span class="v2-exp-pill-count">{timelineRoles.filter(r => r.category === 'community').length}</span>
        </button>
      </div>

      <div class="v2-timeline" role="region" aria-label="Career and Leadership Timeline">
        {timelineRoles.map((role) => (
          <article
            class="v2-timeline-item"
            data-exp-category={role.category}
          >
            <div class="v2-timeline-left">
              <span class="v2-timeline-category">{role.categoryLabel}</span>
              <span class="v2-timeline-period">{role.period}</span>
              <small class="v2-timeline-location">{role.location}</small>
            </div>
            <div class="v2-timeline-content">
              <div class="v2-timeline-header">
                <div>
                  <h3>{role.title}</h3>
                  <p class="v2-timeline-org">{role.organization}</p>
                </div>
                <div class="v2-timeline-badges">
                  <span class="v2-timeline-status">{role.statusLabel}</span>
                  <span class="v2-timeline-metric">{role.metricsBadge}</span>
                </div>
              </div>
              <p class="v2-timeline-summary">{role.summary}</p>

              <button
                type="button"
                class="v2-timeline-toggle"
                aria-expanded="false"
                aria-controls={`exp-drawer-${role.id}`}
              >
                <span class="v2-toggle-text">Show Details & Stack</span>
                <svg class="v2-toggle-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>

              <div class="v2-timeline-drawer" id={`exp-drawer-${role.id}`} hidden>
                <div class="v2-drawer-inner">
                  <div class="v2-drawer-section">
                    <span class="v2-drawer-title">Key Responsibilities & Delivery</span>
                    <ul class="v2-drawer-list">
                      {role.highlights.map((h) => (
                        <li>{h}</li>
                      ))}
                    </ul>
                  </div>
                  <div class="v2-drawer-section">
                    <span class="v2-drawer-title">Technologies & Tools</span>
                    <div class="v2-drawer-tags">
                      {role.techStack.map((tech) => (
                        <span class="v2-drawer-tag">{tech}</span>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="v2-section" id="more">
      <div class="v2-section-head">
        <p class="v2-section-tag">Education & Community</p>
        <h2>Beyond the code</h2>
      </div>
      <div class="v2-more-grid">
        <article>
          <p>Education</p>
          <h3>Bachelor of Computer Science</h3>
          <span>Akhbar El-Yom Academy · Oct 2020 - Jul 2024 · Overall grade 82.88%</span>
        </article>
        <article>
          <p>Community</p>
          <h3>GDSC Flutter Head</h3>
          <span>Led the Flutter team from Oct 2022 - Oct 2023; organized workshops and supported NextGen and Google I/O Extended.</span>
        </article>
        <article>
          <p>Problem Solving</p>
          <h3>ICPC Core Team</h3>
          <span>Core team member from Jun 2020 - Oct 2023; supported contests and competitive-programming training.</span>
        </article>
        <article>
          <p>Automation</p>
          <h3>n8n + LLM Workflows</h3>
          <span>Arabic (Native) · English (Upper-Intermediate) · Military service completed.</span>
        </article>
      </div>
    </section>

    <section class="v2-contact" id="contact">
      <div class="v2-contact-glow"></div>
      <div class="v2-contact-inner">
        <p class="v2-section-tag">Get In Touch</p>
        <h2>Let's build <em>something useful</em></h2>
        <span>Open to software engineering roles, freelance builds, and practical product collaborations across Flutter, backend integrations, and AI-assisted workflows.</span>
        <p class="v2-contact-availability"><strong>Based in Egypt</strong><span>Available for thoughtful product and engineering conversations.</span></p>
        <div class="v2-contact-links">
          {contactActions.map((item) => (
            <a
              class:list={['v2-contact-link', item.label === 'Email' && 'v2-contact-link-primary']}
              href={item.href}
              download={item.download}
              target={item.target}
              rel={item.rel}
              aria-label={`${item.label}${item.label === 'Resume' ? ' from Google Drive' : ''}`}
            >
              <span>{icon(item.icon)}</span>
              {item.label}
            </a>
          ))}
        </div>
      </div>
    </section>

    <footer class="v2-footer">
      <p>© 2026 <em>Eslam Tarek Nabawy</em></p>
      <p>Software Engineer · Egypt · <em>Built with intent</em></p>
    </footer>
  </main>
</BaseLayout>

<script>
  const progress = document.getElementById('v2-progress');
  const updateProgress = () => {
    if (!progress) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    progress.style.width = `${max > 0 ? (window.scrollY / max) * 100 : 0}%`;
  };
  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  const nav = document.querySelector('.v2-nav') as HTMLElement | null;
  const navToggle = document.querySelector('.v2-nav-toggle') as HTMLButtonElement | null;
  const navLinks = document.querySelector('#primary-links') as HTMLElement | null;
  if (nav && navToggle && navLinks) {
    nav.dataset.ready = 'true';

    const setNavOpen = (open: boolean) => {
      nav.dataset.open = String(open);
      navToggle.setAttribute('aria-expanded', String(open));
      navToggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    };

    navToggle.addEventListener('click', () => setNavOpen(nav.dataset.open !== 'true'));
    navLinks.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setNavOpen(false)));
    document.addEventListener('click', (event) => {
      if (!nav.contains(event.target as Node)) setNavOpen(false);
    });
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav.dataset.open === 'true') {
        setNavOpen(false);
        navToggle.focus();
      }
    });

    const sectionLinks = [...navLinks.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const sections = sectionLinks
      .map((link) => document.querySelector(link.getAttribute('href') || ''))
      .filter((section): section is HTMLElement => section instanceof HTMLElement);
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        sectionLinks.forEach((link) => {
          const active = link.getAttribute('href') === `#${visible.target.id}`;
          if (active) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      },
      { rootMargin: '-28% 0px -58% 0px', threshold: [0.1, 0.35, 0.6] },
    );
    sections.forEach((section) => sectionObserver.observe(section));

    window.addEventListener(
      'scroll',
      () => nav.toggleAttribute('data-scrolled', window.scrollY > 12),
      { passive: true },
    );

    const filterPills = Array.from(document.querySelectorAll<HTMLButtonElement>('.v2-filter-pill'));
    const projectCards = Array.from(document.querySelectorAll<HTMLElement>('.v2-project-card'));
    const projectDividers = Array.from(document.querySelectorAll<HTMLElement>('.v2-project-divider'));

    if (filterPills.length > 0 && projectCards.length > 0) {
      filterPills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const filter = pill.dataset.filter || 'all';

          filterPills.forEach((p) => p.setAttribute('aria-selected', String(p === pill)));

          projectCards.forEach((card) => {
            const category = card.dataset.category;
            const match = filter === 'all' || category === filter;
            if (match) {
              card.removeAttribute('data-filtered');
            } else {
              card.setAttribute('data-filtered', 'hidden');
            }
          });

          projectDividers.forEach((divider) => {
            if (filter === 'all') {
              divider.removeAttribute('data-filtered');
            } else {
              divider.setAttribute('data-filtered', 'hidden');
            }
          });
        });
      });
    }

    // ── Skill-to-Project Cross-Highlighting System ──────────────────────
    const skillButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.v2-skill-tag'));
    const techButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.v2-tech-tag'));

    let activeSkill: string | null = null;

    function setSkillHighlight(skill: string | null) {
      if (activeSkill === skill) skill = null; // Toggle off on second click
      activeSkill = skill;

      skillButtons.forEach((btn) => {
        const isCurrent = btn.dataset.skill === skill;
        btn.classList.toggle('is-active', isCurrent);
        btn.setAttribute('aria-pressed', String(isCurrent));
      });

      projectCards.forEach((card) => {
        const stackText = card.dataset.techStack || '[]';
        let stack: string[] = [];
        try { stack = JSON.parse(stackText); } catch { /* ignore */ }
        const matchBadge = card.querySelector<HTMLElement>('.v2-project-match-badge');

        if (!skill) {
          card.classList.remove('is-skill-matched', 'is-skill-dimmed');
          if (matchBadge) matchBadge.hidden = true;
          return;
        }

        const isMatched = stack.some((tech) => tech.includes(skill!) || skill!.includes(tech));

        if (isMatched) {
          card.classList.add('is-skill-matched');
          card.classList.remove('is-skill-dimmed');
          if (matchBadge) {
            matchBadge.textContent = `✨ Uses ${skill}`;
            matchBadge.hidden = false;
          }
        } else {
          card.classList.remove('is-skill-matched');
          card.classList.add('is-skill-dimmed');
          if (matchBadge) matchBadge.hidden = true;
        }
      });
    }

    skillButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const skill = btn.dataset.skill || null;
        setSkillHighlight(skill);
      });
    });

    techButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const tech = btn.dataset.tech;
        if (!tech) return;

        const skillsSection = document.getElementById('skills');
        skillsSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });

        const matchingBtn = skillButtons.find(
          (sBtn) => sBtn.dataset.skill === tech || sBtn.dataset.skill?.includes(tech) || tech.includes(sBtn.dataset.skill || '')
        );

        if (matchingBtn) {
          setSkillHighlight(matchingBtn.dataset.skill || null);
          const group = matchingBtn.closest<HTMLElement>('.v2-skill-group');
          if (group) {
            group.classList.add('v2-skill-group-flash');
            window.setTimeout(() => group.classList.remove('v2-skill-group-flash'), 1200);
          }
        }
      });
    });

    // ── Interactive Timeline Explorer Handlers ──────────────────────────────
    const expPills = Array.from(document.querySelectorAll<HTMLButtonElement>('.v2-exp-pill'));
    const timelineItems = Array.from(document.querySelectorAll<HTMLElement>('.v2-timeline-item'));

    if (expPills.length > 0 && timelineItems.length > 0) {
      expPills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const filter = pill.dataset.expFilter || 'all';

          expPills.forEach((p) => p.setAttribute('aria-selected', String(p === pill)));

          timelineItems.forEach((item) => {
            const cat = item.dataset.expCategory;
            const match = filter === 'all' || cat === filter;
            if (match) {
              item.removeAttribute('data-filtered-hidden');
            } else {
              item.setAttribute('data-filtered-hidden', 'true');
            }
          });
        });
      });
    }

    const timelineToggles = Array.from(document.querySelectorAll<HTMLButtonElement>('.v2-timeline-toggle'));
    timelineToggles.forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
        const targetId = toggle.getAttribute('aria-controls');
        const drawer = targetId ? document.getElementById(targetId) : null;
        const toggleText = toggle.querySelector('.v2-toggle-text');

        toggle.setAttribute('aria-expanded', String(!isExpanded));
        if (toggleText) {
          toggleText.textContent = isExpanded ? 'Show Details & Stack' : 'Hide Details';
        }

        if (drawer) {
          drawer.hidden = isExpanded;
          drawer.classList.toggle('is-open', !isExpanded);
        }
      });
    });
  }

  const canvas = document.getElementById('v2-bg-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const context = canvas.getContext('2d');
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const particles = Array.from({ length: window.innerWidth < 760 ? 28 : 58 }, () => ({
      x: Math.random() * window.innerWidth,
      y: Math.random() * window.innerHeight,
      vx: (Math.random() - 0.5) * 0.2,
      vy: (Math.random() - 0.5) * 0.2,
      r: Math.random() * 1.4 + 0.5,
    }));

    let frameId: number | undefined;

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(window.innerWidth * dpr);
      canvas.height = Math.floor(window.innerHeight * dpr);
      canvas.style.width = `${window.innerWidth}px`;
      canvas.style.height = `${window.innerHeight}px`;
      context?.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const draw = () => {
      if (!context || motionQuery.matches || document.hidden) return;
      context.clearRect(0, 0, window.innerWidth, window.innerHeight);
      particles.forEach((particle) => {
        particle.x += particle.vx;
        particle.y += particle.vy;
        if (particle.x < 0) particle.x = window.innerWidth;
        if (particle.x > window.innerWidth) particle.x = 0;
        if (particle.y < 0) particle.y = window.innerHeight;
        if (particle.y > window.innerHeight) particle.y = 0;

        context.beginPath();
        context.arc(particle.x, particle.y, particle.r, 0, Math.PI * 2);
        context.fillStyle = 'rgba(0, 255, 200, 0.62)';
        context.fill();
      });
      frameId = requestAnimationFrame(draw);
    };

    const stop = () => {
      if (frameId !== undefined) cancelAnimationFrame(frameId);
      frameId = undefined;
    };

    const start = () => {
      if (frameId === undefined && !motionQuery.matches && !document.hidden) draw();
    };

    resize();
    window.addEventListener('resize', resize);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    motionQuery.addEventListener('change', () => {
      stop();
      start();
    });
    start();
  }
</script>
