---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPortfolioData, getProjectHeroImage } from '../lib/portfolio-data';
import type { Project } from '../lib/types';
import '../styles/portfolio-v2.css';

const { config, projects, skills, experiments } = await getPortfolioData();
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const resumeHref = config.resume_url ?? `${base}Eslam's%20Resume.pdf`;

const phoneHref = config.phone ? `tel:${config.phone.replace(/[^\d+]/g, '')}` : null;
const contactActions = [
  { label: 'Email', href: config.email ? `mailto:${config.email}` : null, icon: 'mail' },
  {
    label: 'Resume',
    href: resumeHref,
    icon: 'file',
    download: /^https?:\/\//i.test(resumeHref) ? undefined : 'Eslam Tarek Nabawy Resume.pdf',
    target: /^https?:\/\//i.test(resumeHref) ? '_blank' : undefined,
    rel: /^https?:\/\//i.test(resumeHref) ? 'noopener noreferrer' : undefined,
  },
  { label: 'Phone', href: phoneHref, icon: 'phone' },
  { label: 'GitHub', href: config.github_url, icon: 'github' },
  { label: 'LinkedIn', href: config.linkedin_url, icon: 'linkedin' },
].filter((item) => item.href) as {
  label: string;
  href: string;
  icon: string;
  download?: string;
  target?: string;
  rel?: string;
}[];

const preferredProjectOrder = [
  'brox',
  'ai-workflow-automation',
  'rain-p2p-messenger',
  'campus-suit',
  'silvator',
  'so-she-picks-ecommerce',
];

const orderedProjects = [...projects].sort((left, right) => {
  const leftIndex = preferredProjectOrder.indexOf(left.slug);
  const rightIndex = preferredProjectOrder.indexOf(right.slug);
  const normalizedLeft = leftIndex === -1 ? Number.MAX_SAFE_INTEGER : leftIndex;
  const normalizedRight = rightIndex === -1 ? Number.MAX_SAFE_INTEGER : rightIndex;
  if (normalizedLeft !== normalizedRight) {
    return normalizedLeft - normalizedRight;
  }
  return left.display_order - right.display_order;
});

const skillGroups =
  skills.length > 0
    ? skills
    : [
        {
          category: 'Product Engineering',
          items: ['Flutter', 'Dart', 'Responsive UI', 'State Management'],
        },
        {
          category: 'Data And Integrations',
          items: ['REST APIs', 'Realtime Data', 'Local Storage', 'Auth Flows'],
        },
        {
          category: 'Automation',
          items: ['n8n', 'LLM APIs', 'Webhooks', 'Workflow Design'],
        },
      ];

const highlightedSkills = new Set([
  'Flutter',
  'Dart',
  'BLoC',
  'Cubit',
  'Riverpod',
  'n8n Workflow Automation',
  'OpenAI API Integration',
  'Claude API Integration',
  'REST API Integration',
  'Git / GitHub',
]);

const skillId = (category: string) => `skill-${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;

const projectTone = (project: Project) =>
  ({
    brox: 'brox',
    'rain-p2p-messenger': 'rain',
    'campus-suit': 'campus',
    silvator: 'silvator',
    'ai-workflow-automation': 'ai',
    'so-she-picks-ecommerce': 'shop',
  })[project.slug] ?? 'default';

const projectMeta = (project: Project) =>
  ({
    brox: 'Desktop Operations',
    'rain-p2p-messenger': 'Android / Windows',
    'campus-suit': 'Campus Product',
    silvator: 'Mood Companion',
    'ai-workflow-automation': 'Omnichannel AI Support',
    'so-she-picks-ecommerce': 'Mobile Commerce',
  })[project.slug] ?? 'Software Product';

const projectHighlights: Record<string, string[]> = {
  brox: [
    'Offline-first operations console for desks, rooms, inventory, finance, staff, and memberships.',
    'Role-gated workflows, audit logs, backup / restore, local diagnostics, and release packaging.',
    'Built for repeated front-desk use rather than a one-screen demo.',
  ],
  'rain-p2p-messenger': [
    'Private peer chat across Android and Windows with explicit friend, call, and file states.',
    'Separates UI, persistence, realtime signaling, and WebRTC data / media transport.',
  ],
  'campus-suit': [
    'Graduation project covering onboarding, courses, grades, profile flows, and live campus data.',
    'Structured mobile screens built around clear student workflows.',
  ],
  silvator: [
    'Mood-aware quote, journal, saved insight, and heatmap flows across mobile and desktop screens.',
    'Local-first product surface focused on calm capture and reflection.',
  ],
  'ai-workflow-automation': [
    'Automated customer-service response delivery across WhatsApp and Telegram.',
    'Supabase memory, multi-provider AI routing, and safety gates keep conversations contextual and controlled.',
  ],
  'so-she-picks-ecommerce': [
    'Mobile ordering flow with backend order handling and loyalty points.',
    'Designed around straightforward browsing, checkout, and repeat-customer behavior.',
  ],
};

const projectImageDimensions: Record<string, { width: number; height: number }> = {
  brox: { width: 1600, height: 1000 },
  'rain-p2p-messenger': { width: 1800, height: 1125 },
  'campus-suit': { width: 1600, height: 1000 },
  silvator: { width: 1800, height: 1125 },
};

const skillCode = (category: string) => {
  const normalized = category.toLowerCase();
  if (normalized.includes('mobile')) return 'UI';
  if (normalized.includes('backend')) return 'DB';
  if (normalized.includes('automation') || normalized.includes('ai')) return 'AI';
  if (normalized.includes('engineering')) return 'CS';
  return category.slice(0, 2).toUpperCase();
};

const displayDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  year: 'numeric',
});

const icon = (name: string) => name;
---

<BaseLayout title={`${config.name} | Portfolio`} description={config.headline}>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <main id="main-content" class="v2-portfolio" tabindex="-1">
    <canvas id="v2-bg-canvas" aria-hidden="true"></canvas>
    <div class="v2-progress" id="v2-progress" aria-hidden="true"></div>

    <header class="v2-header">
      <nav class="v2-nav" aria-label="Primary navigation">
        <a class="v2-nav-logo" href={base}>eslam<em>.dev</em></a>
        <button
          class="v2-nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="primary-links"
          aria-label="Open navigation"
        >
          <span aria-hidden="true">Menu</span>
          <span class="sr-only">Toggle navigation</span>
        </button>
        <div class="v2-nav-links" id="primary-links">
          <a href="#projects">Projects</a>
          <a href="#skills">Skills</a>
          <a href="#experience">Experience</a>
          <a href="#contact">Contact</a>
        </div>
        {config.email && (
          <a class="v2-nav-hire" href="#contact">Hire Me</a>
        )}
      </nav>
    </header>

    <section class="v2-hero" id="hero">
      <div class="v2-hero-inner">
        <div class="v2-hero-copy v2-reveal-l">
          <p class="v2-eyebrow"><span></span> Software Engineer</p>
          <h1 class="v2-hero-title">
            Eslam Tarek
            <span>Nabawy</span>
          </h1>
          <p class="v2-hero-role">Cross-platform applications · AI-integrated systems · reliable delivery</p>
          <p class="v2-hero-description">
            I design and ship production-grade software from requirements to deployment: maintainable architecture,
            clean interfaces, reliable integrations, and AI systems with explicit control points.
          </p>
          <ul class="v2-hero-proof" aria-label="Core strengths">
            <li><strong>01</strong><span>Cross-platform delivery</span></li>
            <li><strong>02</strong><span>AI-integrated systems</span></li>
            <li><strong>03</strong><span>Reliable product UI</span></li>
          </ul>
          <div class="v2-hero-actions" aria-label="Primary actions">
            <a
              class="v2-btn v2-btn-fill"
              href={resumeHref}
              download={/^https?:\/\//i.test(resumeHref) ? undefined : 'Eslam Tarek Nabawy Resume.pdf'}
              target={/^https?:\/\//i.test(resumeHref) ? '_blank' : undefined}
              rel={/^https?:\/\//i.test(resumeHref) ? 'noopener noreferrer' : undefined}
            >
                Resume
            </a>
            <a class="v2-btn v2-btn-line" href="#projects">View Projects</a>
            {config.email && (
              <a class="v2-btn v2-btn-line" href={`mailto:${config.email}`}>Email Me</a>
            )}
          </div>
        </div>

        <div class="v2-code-widget v2-reveal-r" aria-label="Profile summary card">
          <div class="v2-code-bar">
            <span></span>
            <span></span>
            <span></span>
            <small>profile.ts</small>
          </div>
          <pre><code><span class="v2-kw">const</span> engineer = {'{'}
  name: <span class="v2-str">'Eslam Nabawy'</span>,
  focus: [<span class="v2-str">'cross-platform apps'</span>, <span class="v2-str">'AI systems'</span>],
  builds: <span class="v2-str">'production-grade software'</span>,
  location: <span class="v2-str">'6th October City, Egypt'</span>,
  availableFor: <span class="v2-str">'software roles'</span>
{'}'};</code></pre>
          <div class="v2-float-tag v2-float-a">cross-platform</div>
          <div class="v2-float-tag v2-float-b">automation</div>
          <div class="v2-float-tag v2-float-c">product UI</div>
        </div>
      </div>
    </section>

    <div class="v2-marquee" aria-hidden="true">
      <div class="v2-marquee-track">
        {['Flutter', 'Dart', 'BLoC', 'Riverpod', 'WebRTC', 'n8n', 'REST APIs', 'Local-first', 'AI-assisted delivery', 'GitHub Actions', 'Product UI', 'Automation'].map((item) => (
          <span><b>/</b>{item}</span>
        ))}
        {['Flutter', 'Dart', 'BLoC', 'Riverpod', 'WebRTC', 'n8n', 'REST APIs', 'Local-first', 'AI-assisted delivery', 'GitHub Actions', 'Product UI', 'Automation'].map((item) => (
          <span><b>/</b>{item}</span>
        ))}
      </div>
    </div>

    <section class="v2-section v2-skills" id="skills">
      <div class="v2-section-head">
        <p class="v2-section-tag">Skills</p>
        <h2>Capabilities, grouped for delivery</h2>
        <span>CV-backed technologies organized by the way they support product delivery: application platforms, integrations, data, AI workflows, and engineering practice.</span>
      </div>

      <div class="v2-skills-layout">
        <div class="v2-orbit" aria-hidden="true">
          <div></div>
          <div></div>
          <div></div>
          <i style="left:50%;top:0"></i>
          <i style="left:93%;top:70%"></i>
          <i style="left:12%;top:78%"></i>
          <strong>{skillGroups.reduce((total, group) => total + group.items.length, 0)}<small>skills</small></strong>
        </div>

        <div class="v2-skill-groups">
          {skillGroups.map((group) => (
            <article class="v2-skill-group" aria-labelledby={skillId(group.category)}>
              <div class="v2-skill-top">
                <span>{skillCode(group.category)}</span>
                <div>
                  <h3 id={skillId(group.category)}>{group.category}</h3>
                  <small>Capability group</small>
                </div>
              </div>
              <div class="v2-skill-tags">
                {group.items.map((item) => (
                  <span class:list={['v2-skill-tag', highlightedSkills.has(item) && 'v2-skill-tag-hot']}>
                    {item}
                  </span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="v2-section" id="projects">
      <div class="v2-section-head">
        <p class="v2-section-tag">Projects</p>
        <h2>Production-grade software, shown clearly</h2>
        <span>Featured work leads with four projects from my current engineering focus. Additional work remains available below for broader context.</span>
      </div>

      <div class="v2-project-grid">
        {orderedProjects.map((project, index) => {
          const image = getProjectHeroImage(project);
          const href = `${base}projects/${project.slug}/`;
          const isPrimary = ['brox', 'ai-workflow-automation', 'rain-p2p-messenger', 'campus-suit'].includes(project.slug);
          const isLarge = project.slug === 'brox';
          const isWide = project.slug === 'so-she-picks-ecommerce';
          const imageDimensions = projectImageDimensions[project.slug];
          const highlights = projectHighlights[project.slug] ?? [project.impact ?? project.role ?? 'Built as a focused product experience.'];

          const additionalWorkHeading = !isPrimary && index === 4 ? (
            <div class="v2-project-divider" aria-label="Additional work">
              <span>Additional work</span>
              <small>More experiments and product interfaces</small>
            </div>
          ) : null;

          return (
            <Fragment>
              {additionalWorkHeading}
              <article class:list={['v2-project-card', isPrimary && 'v2-project-card-primary', isLarge && 'v2-project-card-large', isWide && 'v2-project-card-wide']}>
              <a href={href} aria-label={`View ${project.title} case study`}>
                <div class:list={['v2-project-media', `v2-tone-${projectTone(project)}`]}>
                  {image ? (
                    <img
                      src={image}
                      alt={`${project.title} screenshot mockup`}
                      width={imageDimensions?.width}
                      height={imageDimensions?.height}
                      loading={index === 0 ? 'eager' : 'lazy'}
                      fetchpriority={index === 0 ? 'high' : 'auto'}
                      decoding="async"
                    />
                  ) : (
                    <div class="v2-project-empty">Preview pending</div>
                  )}
                </div>
                <div class="v2-project-body">
                  <div class="v2-project-meta">
                    <span>{projectMeta(project)}</span>
                    <small>{project.updated_at ? displayDate.format(new Date(project.updated_at)) : 'Current'}</small>
                    {isPrimary ? <small class="v2-project-label v2-project-label-selected">Selected work</small> : <small class="v2-project-label">Additional work</small>}
                  </div>
                  <h3>{project.title}</h3>
                  <p class="v2-project-role">{project.role ?? 'Software Engineer'}</p>
                  <p class="v2-project-description">{project.short_description ?? project.description}</p>
                  <div class="v2-project-highlights">
                    {highlights.slice(0, isLarge ? 3 : 2).map((highlight) => (
                      <span>{highlight}</span>
                    ))}
                  </div>
                  <div class="v2-project-stack">
                    {project.tech_stack.slice(0, 7).map((item) => (
                      <span>{item}</span>
                    ))}
                  </div>
                </div>
              </a>
              </article>
            </Fragment>
          );
        })}
      </div>
    </section>

    <section class="v2-section v2-experience" id="experience">
      <div class="v2-section-head">
        <p class="v2-section-tag">Experience</p>
        <h2>Where the work happened</h2>
        <span>Teaching, freelance delivery, mentoring, and community work that support the engineering.</span>
      </div>

      <div class="v2-timeline">
        {experiments.map((experiment) => (
          <article class="v2-timeline-item">
            <div>
              <small>{experiment.category}</small>
              <h3>{experiment.title}</h3>
              <span>{experiment.status}</span>
            </div>
            <p>{experiment.summary}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="v2-section" id="more">
      <div class="v2-section-head">
        <p class="v2-section-tag">Education & Community</p>
        <h2>Beyond the code</h2>
      </div>
      <div class="v2-more-grid">
        <article>
          <p>Education</p>
          <h3>Bachelor of Computer Science</h3>
          <span>Akhbar El-Yom Academy · Oct 2020 - Jul 2024 · Overall grade 82.88%</span>
        </article>
        <article>
          <p>Community</p>
          <h3>GDSC Flutter Head</h3>
          <span>Led the Flutter team from Oct 2022 - Oct 2023; organized workshops and supported NextGen and Google I/O Extended.</span>
        </article>
        <article>
          <p>Problem Solving</p>
          <h3>ICPC Core Team</h3>
          <span>Core team member from Jun 2020 - Oct 2023; supported contests and competitive-programming training.</span>
        </article>
        <article>
          <p>Automation</p>
          <h3>n8n + LLM Workflows</h3>
          <span>Arabic (Native) · English (Upper-Intermediate) · Military service completed.</span>
        </article>
      </div>
    </section>

    <section class="v2-contact" id="contact">
      <div class="v2-contact-glow"></div>
      <div class="v2-contact-inner">
        <p class="v2-section-tag">Get In Touch</p>
        <h2>Let's build <em>something useful</em></h2>
        <span>Open to software engineering roles, freelance builds, and practical product collaborations across Flutter, backend integrations, and AI-assisted workflows.</span>
        <p class="v2-contact-availability"><strong>Based in Egypt</strong><span>Available for thoughtful product and engineering conversations.</span></p>
        <div class="v2-contact-links">
          {contactActions.map((item) => (
            <a
              class:list={['v2-contact-link', item.label === 'Email' && 'v2-contact-link-primary']}
              href={item.href}
              download={item.download}
              target={item.target}
              rel={item.rel}
              aria-label={`${item.label}${item.label === 'Resume' ? ' from Google Drive' : ''}`}
            >
              <span>{icon(item.icon)}</span>
              {item.label}
            </a>
          ))}
        </div>
      </div>
    </section>

    <footer class="v2-footer">
      <p>© 2026 <em>Eslam Tarek Nabawy</em></p>
      <p>Software Engineer · Egypt · <em>Built with intent</em></p>
    </footer>
  </main>
</BaseLayout>

<script>
  const progress = document.getElementById('v2-progress');
  const updateProgress = () => {
    if (!progress) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    progress.style.width = `${max > 0 ? (window.scrollY / max) * 100 : 0}%`;
  };
  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  const nav = document.querySelector('.v2-nav') as HTMLElement | null;
  const navToggle = document.querySelector('.v2-nav-toggle') as HTMLButtonElement | null;
  const navLinks = document.querySelector('#primary-links') as HTMLElement | null;
  if (nav && navToggle && navLinks) {
    nav.dataset.ready = 'true';

    const setNavOpen = (open: boolean) => {
      nav.dataset.open = String(open);
      navToggle.setAttribute('aria-expanded', String(open));
      navToggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    };

    navToggle.addEventListener('click', () => setNavOpen(nav.dataset.open !== 'true'));
    navLinks.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setNavOpen(false)));
    document.addEventListener('click', (event) => {
      if (!nav.contains(event.target as Node)) setNavOpen(false);
    });
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav.dataset.open === 'true') {
        setNavOpen(false);
        navToggle.focus();
      }
    });

    const sectionLinks = [...navLinks.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const sections = sectionLinks
      .map((link) => document.querySelector(link.getAttribute('href') || ''))
      .filter((section): section is HTMLElement => section instanceof HTMLElement);
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        sectionLinks.forEach((link) => {
          const active = link.getAttribute('href') === `#${visible.target.id}`;
          if (active) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      },
      { rootMargin: '-28% 0px -58% 0px', threshold: [0.1, 0.35, 0.6] },
    );
    sections.forEach((section) => sectionObserver.observe(section));

    window.addEventListener(
      'scroll',
      () => nav.toggleAttribute('data-scrolled', window.scrollY > 12),
      { passive: true },
    );
  }

  const canvas = document.getElementById('v2-bg-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const context = canvas.getContext('2d');
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const particles = Array.from({ length: window.innerWidth < 760 ? 28 : 58 }, () => ({
      x: Math.random() * window.innerWidth,
      y: Math.random() * window.innerHeight,
      vx: (Math.random() - 0.5) * 0.2,
      vy: (Math.random() - 0.5) * 0.2,
      r: Math.random() * 1.4 + 0.5,
    }));

    let frameId: number | undefined;

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(window.innerWidth * dpr);
      canvas.height = Math.floor(window.innerHeight * dpr);
      canvas.style.width = `${window.innerWidth}px`;
      canvas.style.height = `${window.innerHeight}px`;
      context?.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const draw = () => {
      if (!context || motionQuery.matches || document.hidden) return;
      context.clearRect(0, 0, window.innerWidth, window.innerHeight);
      particles.forEach((particle) => {
        particle.x += particle.vx;
        particle.y += particle.vy;
        if (particle.x < 0) particle.x = window.innerWidth;
        if (particle.x > window.innerWidth) particle.x = 0;
        if (particle.y < 0) particle.y = window.innerHeight;
        if (particle.y > window.innerHeight) particle.y = 0;

        context.beginPath();
        context.arc(particle.x, particle.y, particle.r, 0, Math.PI * 2);
        context.fillStyle = 'rgba(0, 255, 200, 0.62)';
        context.fill();
      });
      frameId = requestAnimationFrame(draw);
    };

    const stop = () => {
      if (frameId !== undefined) cancelAnimationFrame(frameId);
      frameId = undefined;
    };

    const start = () => {
      if (frameId === undefined && !motionQuery.matches && !document.hidden) draw();
    };

    resize();
    window.addEventListener('resize', resize);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    motionQuery.addEventListener('change', () => {
      stop();
      start();
    });
    start();
  }
</script>
